digraph ThreadedTree {
  graph [rankdir=TB, ordering=out, nodesep=0.6, ranksep=0.9,
         labelloc=b, label="Black: child | Red dashed: thread"];
  node [shape=plain, fontname="DejaVu Sans"];
  edge [arrowsize=0.7];
  n0 [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0"><TR><TD COLSPAN="2" BGCOLOR="#dbeafe">8</TD></TR><TR><TD COLSPAN="2">h=3, size=14</TD></TR><TR><TD PORT="l">L</TD><TD PORT="r">R</TD></TR></TABLE>>];
  n1 [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0"><TR><TD COLSPAN="2" BGCOLOR="#f3f4f6">4</TD></TR><TR><TD COLSPAN="2">h=2, size=7</TD></TR><TR><TD PORT="l">L</TD><TD PORT="r">R</TD></TR></TABLE>>];
  n2 [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0"><TR><TD COLSPAN="2" BGCOLOR="#f3f4f6">12</TD></TR><TR><TD COLSPAN="2">h=2, size=6</TD></TR><TR><TD PORT="l">L</TD><TD PORT="r">R</TD></TR></TABLE>>];
  n3 [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0"><TR><TD COLSPAN="2" BGCOLOR="#f3f4f6">2</TD></TR><TR><TD COLSPAN="2">h=1, size=3</TD></TR><TR><TD PORT="l">L</TD><TD PORT="r">R</TD></TR></TABLE>>];
  n4 [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0"><TR><TD COLSPAN="2" BGCOLOR="#f3f4f6">6</TD></TR><TR><TD COLSPAN="2">h=1, size=3</TD></TR><TR><TD PORT="l">L</TD><TD PORT="r">R</TD></TR></TABLE>>];
  n5 [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0"><TR><TD COLSPAN="2" BGCOLOR="#f3f4f6">10</TD></TR><TR><TD COLSPAN="2">h=1, size=3</TD></TR><TR><TD PORT="l">L</TD><TD PORT="r">R</TD></TR></TABLE>>];
  n6 [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0"><TR><TD COLSPAN="2" BGCOLOR="#f3f4f6">13</TD></TR><TR><TD COLSPAN="2">h=1, size=2</TD></TR><TR><TD PORT="l">L</TD><TD PORT="r">R</TD></TR></TABLE>>];
  n7 [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0"><TR><TD COLSPAN="2" BGCOLOR="#f3f4f6">1</TD></TR><TR><TD COLSPAN="2">h=0, size=1</TD></TR><TR><TD PORT="l">L=nullptr</TD><TD PORT="r">R</TD></TR></TABLE>>];
  n8 [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0"><TR><TD COLSPAN="2" BGCOLOR="#f3f4f6">3</TD></TR><TR><TD COLSPAN="2">h=0, size=1</TD></TR><TR><TD PORT="l">L</TD><TD PORT="r">R</TD></TR></TABLE>>];
  n9 [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0"><TR><TD COLSPAN="2" BGCOLOR="#f3f4f6">5</TD></TR><TR><TD COLSPAN="2">h=0, size=1</TD></TR><TR><TD PORT="l">L</TD><TD PORT="r">R</TD></TR></TABLE>>];
  n10 [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0"><TR><TD COLSPAN="2" BGCOLOR="#f3f4f6">7</TD></TR><TR><TD COLSPAN="2">h=0, size=1</TD></TR><TR><TD PORT="l">L</TD><TD PORT="r">R</TD></TR></TABLE>>];
  n11 [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0"><TR><TD COLSPAN="2" BGCOLOR="#f3f4f6">9</TD></TR><TR><TD COLSPAN="2">h=0, size=1</TD></TR><TR><TD PORT="l">L</TD><TD PORT="r">R</TD></TR></TABLE>>];
  n12 [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0"><TR><TD COLSPAN="2" BGCOLOR="#f3f4f6">11</TD></TR><TR><TD COLSPAN="2">h=0, size=1</TD></TR><TR><TD PORT="l">L</TD><TD PORT="r">R</TD></TR></TABLE>>];
  n13 [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0"><TR><TD COLSPAN="2" BGCOLOR="#f3f4f6">14</TD></TR><TR><TD COLSPAN="2">h=0, size=1</TD></TR><TR><TD PORT="l">L</TD><TD PORT="r">R=nullptr</TD></TR></TABLE>>];
  n0:l -> n1 [color="#111827", penwidth=1.5];
  n0:r -> n2 [color="#111827", penwidth=1.5];
  n1:l -> n3 [color="#111827", penwidth=1.5];
  n1:r -> n4 [color="#111827", penwidth=1.5];
  n2:l -> n5 [color="#111827", penwidth=1.5];
  n2:r -> n6 [color="#111827", penwidth=1.5];
  n3:l -> n7 [color="#111827", penwidth=1.5];
  n3:r -> n8 [color="#111827", penwidth=1.5];
  n4:l -> n9 [color="#111827", penwidth=1.5];
  n4:r -> n10 [color="#111827", penwidth=1.5];
  n5:l -> n11 [color="#111827", penwidth=1.5];
  n5:r -> n12 [color="#111827", penwidth=1.5];
  n6:l -> n2 [color="#dc2626", style=dashed, constraint=false];
  n6:r -> n13 [color="#111827", penwidth=1.5];
  n7:r -> n3 [color="#dc2626", style=dashed, constraint=false];
  n8:l -> n3 [color="#dc2626", style=dashed, constraint=false];
  n8:r -> n1 [color="#dc2626", style=dashed, constraint=false];
  n9:l -> n1 [color="#dc2626", style=dashed, constraint=false];
  n9:r -> n4 [color="#dc2626", style=dashed, constraint=false];
  n10:l -> n4 [color="#dc2626", style=dashed, constraint=false];
  n10:r -> n0 [color="#dc2626", style=dashed, constraint=false];
  n11:l -> n0 [color="#dc2626", style=dashed, constraint=false];
  n11:r -> n5 [color="#dc2626", style=dashed, constraint=false];
  n12:l -> n5 [color="#dc2626", style=dashed, constraint=false];
  n12:r -> n2 [color="#dc2626", style=dashed, constraint=false];
  n13:l -> n6 [color="#dc2626", style=dashed, constraint=false];
}
